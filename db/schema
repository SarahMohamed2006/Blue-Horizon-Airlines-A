-- Blue Horizon Airlines
-- Database Schema
-- SQLite

PRAGMA foreign_keys = ON;

-- Airports
-- Stores airport information and operational conditions.

CREATE TABLE Airports (
    airport_id INTEGER PRIMARY KEY,

    name VARCHAR(100) NOT NULL,

    weather VARCHAR(50) NOT NULL
        CHECK (weather IN (
            'Clear',
            'Sunny',
            'Cloudy',
            'Rainy',
            'Storm',
            'Fog'
        )),

    runway_status VARCHAR(30) NOT NULL
        CHECK (runway_status IN (
            'Open',
            'Closed',
            'Restricted'
        ))
);

-- Aircraft
-- Stores airline fleet information.

CREATE TABLE Aircraft (

    aircraft_id INTEGER PRIMARY KEY,

    tail_number VARCHAR(20) NOT NULL UNIQUE,

    model VARCHAR(50) NOT NULL,

    capacity INTEGER NOT NULL
        CHECK (capacity > 0),

    status VARCHAR(30) NOT NULL
        CHECK (
            status IN (
                'Available',
                'Assigned',
                'In Service',
                'Maintenance'
            )
        ),

    current_airport_id INTEGER,

    FOREIGN KEY (current_airport_id)
        REFERENCES Airports(airport_id)
);

-- Flights
-- Stores scheduled airline flights.

CREATE TABLE Flights (

    flight_id INTEGER PRIMARY KEY,

    flight_number VARCHAR(20) NOT NULL UNIQUE,

    origin_airport_id INTEGER NOT NULL,

    destination_airport_id INTEGER NOT NULL,

    departure_time DATETIME NOT NULL,

    arrival_time DATETIME NOT NULL,

    status VARCHAR(30) NOT NULL
        CHECK (
            status IN (
                'Scheduled',
                'Delayed',
                'Rescheduled',
                'Cancelled',
                'Completed'
            )
        ),

    aircraft_id INTEGER,

    CHECK (arrival_time > departure_time),

    FOREIGN KEY (origin_airport_id)
        REFERENCES Airports(airport_id),

    FOREIGN KEY (destination_airport_id)
        REFERENCES Airports(airport_id),

    FOREIGN KEY (aircraft_id)
        REFERENCES Aircraft(aircraft_id)
);

-- Crew
-- Stores flight crew members.

CREATE TABLE Crew (

    crew_id INTEGER PRIMARY KEY,

    name VARCHAR(100) NOT NULL,

    role VARCHAR(50) NOT NULL,

    license_type VARCHAR(50),

    availability BOOLEAN NOT NULL
        CHECK (availability IN (0,1)),

    hours_flown_today DECIMAL(4,1)
        DEFAULT 0
        CHECK (
            hours_flown_today >= 0
            AND hours_flown_today <= 24
        )
);

-- Flight Crew
-- Many-to-Many relationship.

CREATE TABLE FlightCrew (

    flight_id INTEGER NOT NULL,

    crew_id INTEGER NOT NULL,

    PRIMARY KEY (
        flight_id,
        crew_id
    ),

    FOREIGN KEY (flight_id)
        REFERENCES Flights(flight_id),

    FOREIGN KEY (crew_id)
        REFERENCES Crew(crew_id)
);
-- Maintenance
-- Stores aircraft maintenance records.

CREATE TABLE Maintenance (

    maintenance_id INTEGER PRIMARY KEY,

    aircraft_id INTEGER NOT NULL,

    severity VARCHAR(20) NOT NULL
        CHECK (
            severity IN (
                'Low',
                'Medium',
                'High',
                'Critical'
            )
        ),

    status VARCHAR(30) NOT NULL
        CHECK (
            status IN (
                'Pending',
                'In Progress',
                'Completed'
            )
        ),

    engineer VARCHAR(100) NOT NULL,

    FOREIGN KEY (aircraft_id)
        REFERENCES Aircraft(aircraft_id)
);

-- Employees
-- Stores airline employees.

CREATE TABLE Employees (

    employee_id INTEGER PRIMARY KEY,

    name VARCHAR(100) NOT NULL,

    role VARCHAR(50) NOT NULL
        CHECK (
            role IN (
                'Operations Manager',
                'Dispatcher',
                'Maintenance Engineer',
                'Supervisor'
            )
        )
);

-- Aircraft Assignments
-- Tracks aircraft assignment history.

CREATE TABLE AircraftAssignments (

    assignment_id INTEGER PRIMARY KEY AUTOINCREMENT,

    flight_id INTEGER NOT NULL,

    aircraft_id INTEGER NOT NULL,

    assigned_at DATETIME NOT NULL
        DEFAULT CURRENT_TIMESTAMP,

    assignment_reason VARCHAR(100),

    FOREIGN KEY (flight_id)
        REFERENCES Flights(flight_id),

    FOREIGN KEY (aircraft_id)
        REFERENCES Aircraft(aircraft_id)
);

-- Crew Assignments
-- Tracks crew assignment history.

CREATE TABLE CrewAssignments (

    assignment_id INTEGER PRIMARY KEY AUTOINCREMENT,

    flight_id INTEGER NOT NULL,

    crew_id INTEGER NOT NULL,

    assigned_at DATETIME NOT NULL
        DEFAULT CURRENT_TIMESTAMP,

    assignment_status VARCHAR(30) NOT NULL
        CHECK (
            assignment_status IN (
                'Assigned',
                'Active',
                'Completed'
            )
        ),

    FOREIGN KEY (flight_id)
        REFERENCES Flights(flight_id),

    FOREIGN KEY (crew_id)
        REFERENCES Crew(crew_id)
);

-- Flight Events
-- Stores operational events affecting flights.

CREATE TABLE FlightEvents (

    event_id INTEGER PRIMARY KEY AUTOINCREMENT,

    flight_id INTEGER NOT NULL,

    event_type VARCHAR(50) NOT NULL,

    severity VARCHAR(20) NOT NULL
        CHECK (
            severity IN (
                'Low',
                'Medium',
                'High',
                'Critical'
            )
        ),

    description VARCHAR(255),

    reported_at DATETIME NOT NULL
        DEFAULT CURRENT_TIMESTAMP,

    status VARCHAR(30) NOT NULL
        CHECK (
            status IN (
                'Open',
                'Closed',
                'Resolved'
            )
        ),

    FOREIGN KEY (flight_id)
        REFERENCES Flights(flight_id)
);
